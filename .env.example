# docker-compose.yml 的設定範本（docs/docker.md）。複製成 .env 再改；.env 不進 git。
# 這裡只放「容器怎麼跑」的設定。Telegram／Discord 的 token、AI 金鑰請用 `docker compose run --rm synox init`
# 存進 SYNOX 的設定與保管箱，不要寫在這裡（環境變數會出現在 docker inspect）。

# 網頁的埠：宿主只在 127.0.0.1 上開這個埠。要跟 config.json 的 web.port 一樣（預設都是 8830）
SYNOX_WEB_PORT=8830

# 時區：提醒、排程照這個時間算。例如 Asia/Taipei、Europe/Berlin、America/New_York
TZ=UTC

# 資源上限（範例值；個人版這樣就夠）
SYNOX_MEM_LIMIT=512m
SYNOX_CPUS=1.0
SYNOX_PIDS_LIMIT=256

# 選用：用 API 金鑰的 AI 想走環境變數時才填，並把 docker-compose.yml 那一行的 # 拿掉
# SYNOX_LLM_API_KEY=
