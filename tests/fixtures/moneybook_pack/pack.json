{
  "name": "moneybook",
  "title": "💰 金流簿",
  "summary": "記一筆、看這個月、預算、撤銷、CSV 匯出匯入（每個人自己一本）",
  "version": "0.17.0",
  "kind": "cli",
  "group": "moneybook",
  "access": "member",
  "surfaces": ["dm"],
  "data": "user",
  "order": 20,
  "skill": "SKILL.md",
  "storage": "plain",
  "auth": "none",
  "capabilities": ["subprocess"],
  "requires": { "pip": [], "config": [], "env": {} },
  "runtime": {
    "python": "../.venv/Scripts/python.exe",
    "python_posix": "../.venv/bin/python",
    "note": "{python} 要換成這個 repo 的 venv（裡面裝了 moneybook），不是 SYNOX 自己的 Python；見 README.md"
  },
  "env": {
    "MONEYBOOK_HOME": "{user_data_dir}/moneybook",
    "MONEYBOOK_SEED": "generic",
    "MONEYBOOK_FILES_ROOT": "{user_data_dir}/moneybook/files",
    "MONEYBOOK_LLM": "off"
  },
  "cli": {
    "argv": ["{python}", "-m", "moneybook"],
    "cwd": ".",
    "json_flag": "--json",
    "timeout": 60,
    "commands": [
      {"name": "add", "default": true, "positional": 2, "effect": "write", "summary": "記一筆花費（類別不給會猜）",
       "argv": ["txn", "add", "--amount={amount}", "--desc={desc}", "--category={category}", "--account={account}",
                "--date={date}", "--time={time}", "--note={note}"],
       "fields": [{"name": "amount", "ask": "多少錢（整數元）", "required": true},
                  {"name": "desc", "ask": "買了什麼"},
                  {"name": "category", "ask": "類別（不給會猜；categories 看全部）"},
                  {"name": "account", "ask": "用哪個帳戶付（不給＝預設帳戶）"},
                  {"name": "date", "ask": "日期 YYYY-MM-DD（不給＝今天）"},
                  {"name": "time", "ask": "時間 HH:MM"},
                  {"name": "note", "ask": "備註"}]},
      {"name": "income", "positional": 2, "effect": "write", "summary": "記一筆收入",
       "argv": ["txn", "add", "--kind=income", "--amount={amount}", "--desc={desc}", "--category={category}",
                "--account={account}", "--date={date}"],
       "fields": [{"name": "amount", "ask": "多少錢（整數元）", "required": true},
                  {"name": "desc", "ask": "什麼收入"},
                  {"name": "category", "ask": "類別（薪資、兼職、投資收益、退款回饋、其他收入）"},
                  {"name": "account", "ask": "進哪個帳戶"},
                  {"name": "date", "ask": "日期 YYYY-MM-DD（不給＝今天）"}]},
      {"name": "list", "effect": "read", "summary": "列出最近的帳（可以帶關鍵字）",
       "argv": ["txn", "list", "--period={period}", "--q={q}", "--category={category}", "--limit={limit}"],
       "fields": [{"name": "period", "ask": "哪一期，例 2026-10（不給＝本期）"},
                  {"name": "q", "ask": "關鍵字"},
                  {"name": "category", "ask": "類別"},
                  {"name": "limit", "ask": "幾筆", "default": "20"}]},
      {"name": "summary", "effect": "read", "summary": "這個月花了多少、還能花多少",
       "argv": ["summary", "--period={period}"],
       "fields": [{"name": "period", "ask": "哪一期，例 2026-10（不給＝本期）"}]},
      {"name": "budget", "effect": "read", "summary": "每個大類的預算、已花、剩多少",
       "argv": ["budget", "show", "--period={period}"],
       "fields": [{"name": "period", "ask": "哪一期（不給＝本期）"}]},
      {"name": "budget_set", "positional": 1, "effect": "write", "summary": "設某個大類這期的預算",
       "argv": ["budget", "set", "--group={group}", "--amount={amount}", "--period={period}"],
       "fields": [{"name": "group", "ask": "哪個大類，例 食", "required": true},
                  {"name": "amount", "ask": "預算多少（整數元）", "required": true},
                  {"name": "period", "ask": "從哪一期（不給＝本期）"}]},
      {"name": "check", "effect": "read", "summary": "額度提醒：哪一格超過、走太快、還沒設",
       "argv": ["plan", "check"]},
      {"name": "categories", "effect": "read", "summary": "有哪些類別", "argv": ["category", "list"]},
      {"name": "accounts", "effect": "read", "summary": "有哪些帳戶與餘額", "argv": ["account", "list"]},
      {"name": "undo", "effect": "danger", "summary": "撤銷最近一批寫入（剛剛記錯的那筆）", "argv": ["batch", "undo"]},
      {"name": "export", "effect": "write", "summary": "一個月的帳匯出成 CSV（存在自己的資料夾）",
       "argv": ["ledger", "export", "--month={month}", "--format=csv", "--out={out}"],
       "fields": [{"name": "month", "ask": "哪個月 YYYY-MM", "required": true},
                  {"name": "out", "ask": "檔名（不給＝exports/moneybook-YYYY-MM.csv）"}]},
      {"name": "import_csv", "effect": "write", "summary": "從 CSV 匯入（同一個檔再匯一次不會多）",
       "argv": ["ledger", "import-csv", "--file={file}"],
       "fields": [{"name": "file", "ask": "CSV 檔名（放在自己的 files 資料夾）", "required": true}]},
      {"name": "init", "effect": "write", "summary": "開帳本（通用的起始類別：食衣住行育樂醫療其他）",
       "argv": ["setup", "init", "--seed=generic"]},
      {"name": "features", "effect": "read", "summary": "選配的格子（奉獻、投資、還債、薪資扣繳）開了沒",
       "argv": ["setup", "features"]},
      {"name": "enable", "effect": "write", "summary": "打開一個選配的格子",
       "argv": ["setup", "enable", "{feature}"],
       "fields": [{"name": "feature", "ask": "哪一個", "required": true,
                   "choices": ["tithe", "invest", "debt", "payroll", "trading"]}]}
    ]
  }
}
